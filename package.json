{
  "name": "@eliware/ask",
  "type": "module",
  "version": "9.0.0",
  "description": "A concise Discord assistant (\"/ask\") for quick answers, web searches, and image generation — supports slash command, mention/DM fallbacks, localization, and usage tracking.",
  "main": "ask.mjs",
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "audit": "eliware-test --audit",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eliware/ask"
  },
  "keywords": [
    "discord",
    "slash-command",
    "ask",
    "assistant",
    "ai",
    "openai",
    "image-generation",
    "web-search",
    "localization",
    "rate-limiting",
    "nodejs"
  ],
  "author": "Eli Sterling, eliware.org <eli@eliware.org>",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "26"
  },
  "bugs": {
    "url": "https://github.com/eliware/ask/issues"
  },
  "homepage": "https://github.com/eliware/ask#readme",
  "devDependencies": {
    "@eliware/test": "^8.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "collectCoverageFrom": [
      "src/**/*.mjs"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ]
  },
  "dependencies": {
    "@eliware/common": "^2.0.0",
    "@eliware/discord": "^2.0.0",
    "@eliware/openai": "^1.1.11",
    "dotenv": "^18.0.5"
  },
  "eliware": {
    "id": "E-3000",
    "apply": [
      "general",
      "application",
      "discord",
      "ghcr-published"
    ]
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  }
}
